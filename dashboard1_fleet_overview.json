      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(max by (server_name)(hpilo_memory_status==2 or hpilo_storage_status==2 or hpilo_fans_status==2 or hpilo_power_supplies_status==2 or hpilo_temperature_status==2 or hpilo_processor_status==2)) or vector(0)",
