            "lineWidth": 0.8,
            "opacity": 0.9,
            "showValue": "never",
            "stacking": "normal",
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "spaceAround": 0,
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "merge": true,
        "showValue": "never",
        "altField": "",
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
