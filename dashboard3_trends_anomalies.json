  "description": "Тренды деградации и аномалии парка HPE ProLiant DL380p Gen8 (iLO 4) через hpilo-exporter.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 18,
      "type": "timeseries",
      "title": "Тренд средних температур (30d)",
      "description": "Сглаженные (скользящее окно 7 дней) значения входного (Front Ambient) и выходного (Sys Exhaust) воздуха за 30 дней. Медленный рост тренда = деградация охлаждения стойки/ЦОД или забитые фильтры. Пороги: 60°C жёлтый, 75°C красный.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": null,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 4,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "barAlignment": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "avg_over_time(hpilo_temperature_value{server_name=~\"$server\", sensor=~\"01-Front Ambient|49-Sys Exhaust\"}[7d])",
          "instant": false,
          "range": true,
          "legendFormat": "{{server_name}} / {{sensor}}",
          "hide": false,
          "interval": "6h"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Деградация кулеров: минимальная скорость за 30 дней",
      "description": "Минимальная (и средняя) скорость каждого веера в скользящем окне 7 дней. Провалы минимума ниже базовой линии — признак отказа подшипника, загрязнения или неадекватной реакции iLO на нагрев. Для сравнения добавлена средняя скорость.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 4,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "barAlignment": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": "off"
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "min_over_time(hpilo_fan_speed{server_name=~\"$server\"}[7d])",
          "instant": false,
          "range": true,
          "legendFormat": "{{server_name}} / {{fan}}",
          "hide": false,
          "interval": "6h"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "avg_over_time(hpilo_fan_speed{server_name=~\"$server\"}[7d])",
          "instant": false,
          "range": true,
          "legendFormat": "{{server_name}} / {{fan}} (средняя)",
          "hide": false,
          "interval": "6h"
        }
      ]
    },
    {
      "id": 20,
      "type": "state-timeline",
      "title": "История смен статуса питания",
      "description": "hpilo_running_status: 0 = Off (серый), 1 = Standby (жёлтый), 2 = Powered On (зелёный). Значение 2 — это включённый сервер, а НЕ Critical. Внезапные переходы Off/Standby = перезагрузки, плановые работы или потери питания.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "id": 0,
              "type": "value",
              "options": {
                "0": {
                  "text": "Off",
                  "color": "gray",
                  "index": 0
                },
                "1": {
                  "text": "Standby",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Powered On",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "unit": "none",
          "decimals": 0,
          "custom": {
            "align": "auto",
            "altThresholds": [],
            "cellOptions": {
              "type": "auto",
              "inspectMode": "popover"
            },
            "frameIndex": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineWidth": 0.8,
            "opacity": 0.9,
            "showValue": "never",
            "stacking": "normal",
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "spaceAround": 0,
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "merge": true,
        "showValue": "never",
        "altField": "",
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "hpilo_running_status{server_name=~\"$server\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{server_name}}",
          "hide": false,
          "interval": "5m"
        }
      ]
    },
    {
      "id": 21,
      "type": "state-timeline",
      "title": "Изменения статусов компонентов (Memory / Storage)",
      "description": "История переходов состояний hpilo_memory_status и hpilo_storage_status: 0 = OK (зелёный), 1 = Warning (жёлтый), 2 = Critical (красный). Точки частой смены статуса помогают коррелировать инциденты.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "id": 0,
