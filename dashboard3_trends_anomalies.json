                },
                "1": {
                  "text": "Warning",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Critical",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "unit": "none",
          "decimals": 0,
          "custom": {
            "align": "auto",
            "altThresholds": [],
            "cellOptions": {
              "type": "auto",
