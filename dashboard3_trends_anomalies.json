            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "hpilo_memory_status{server_name=~\"$server\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{server_name}} · Memory",
          "hide": false,
          "interval": "5m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
